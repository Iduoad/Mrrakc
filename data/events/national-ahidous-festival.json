  "spec": {
    "name": "National Ahidous Festival",
    "id": "national-ahidous-festival",
    "description": "National festival dedicated to Ahidous, the collective sung dance of the Amazigh tribes of the Middle Atlas, performed jointly by men and women to the rhythm of the bendir. Troupes from across the region perform and compete. Historically associated with Ain Leuh, in Ifrane province.",
    "status": "active",
    "host": {
      "provinces": [
        "province/ifrane"
      ]
    },
    "recurrence": {
      "frequency": "annual",
      "type": "gregorian",
      "months": [
        12
      ],
      "part": "early",
      "typicalDurationDays": 3,
      "note": "Historically held in summer in Ain Leuh; the 20th edition took place in early December"
    },
    "admission": {
      "options": [
        {
          "title": "Open-air performances",
          "modality": "free",
          "audience": "all",
          "entranceFee": -1
        }
