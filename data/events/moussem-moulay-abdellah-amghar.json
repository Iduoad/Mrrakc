  "spec": {
    "name": "Moussem of Moulay Abdellah Amghar",
    "id": "moussem-moulay-abdellah-amghar",
    "description": "One of the largest religious moussems in Morocco, held around the mausoleum of Moulay Abdellah Amghar near El Jadida. It is famous for its massive tbourida (fantasia) gatherings, drawing hundreds of horse troupes and hundreds of thousands of visitors.",
    "status": "active",
