      "provinces": [
        "province/el-jadida"
      ]
    },
    "recurrence": {
      "frequency": "annual",
      "type": "hijri",
      "hijriMonth": 3,
      "observance": "mawlid",
      "note": "Traditionally tied to the weeks around Mawlid; exact Gregorian dates drift each year and are announced close to the event"
    },
