    "name": "Tan-Tan Moussem",
    "id": "tan-tan-moussem",
    "description": "Annual gathering of Saharan nomadic tribes in Tan-Tan, featuring camel markets, tbourida, Hassani poetry and music, traditional games and crafts. Proclaimed by UNESCO a Masterpiece of the Oral and Intangible Heritage of Humanity and inscribed on the Representative List in 2008.",
    "status": "active",
    "host": {
      "provinces": [
        "province/tan-tan"
      ]
    },
    "recurrence": {
      "frequency": "annual",
      "type": "gregorian",
      "months": [
        5,
        6
      ],
      "note": "Originally tied to the seasonal gathering of nomadic tribes; modern editions are usually held in May or June"
    },
