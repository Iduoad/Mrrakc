  "spec": {
    "name": "National Festival of Dakka and Rhythms",
    "id": "national-dakka-festival",
    "description": "National festival in Taroudant celebrating dakka, a collective percussion and chant art historically tied to craftsmen's guilds, famous in its Roudani (Taroudant) and Marrakchi forms. Researchers trace the origins of the art to Taroudant itself.",
