  "spec": {
    "name": "Gharnati Music Festival",
    "id": "gharnati-music-festival",
    "description": "Festival celebrating Gharnati music, an Andalusi musical tradition rooted in medieval Granada and preserved in Oujda and Tlemcen. It aims to keep this refined repertoire alive by showcasing masters and encouraging young talents from conservatories.",
    "status": "active",
