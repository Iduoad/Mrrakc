  "spec": {
    "name": "Oriental Popular Arts Festival",
    "id": "oriental-popular-arts-festival",
    "description": "Festival of the popular arts of Morocco's Oriental region, carried by troupes who inherited the repertoire orally: nhari dance, laarfa, alaoui, mengouchi and reggada, accompanied by regional instruments such as the kallal, zamar and gasba.",
    "status": "active",
